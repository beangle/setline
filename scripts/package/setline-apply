#!/bin/bash
# setline-apply: 校验并热加载 setline 生成的边缘代理配置片段。
#
# 设计取舍见 docs/agent-reload.md，接线方式见 docs/haproxy-integration.md /
# docs/nginx-integration.md，要点：
#   - 只做「片段已在磁盘上之后」的事，不参与生成；
#   - 幂等：内容哈希没变就直接退出，重复触发是免费的；
#   - 防抖用 mtime 静默窗口，不在脚本里 sleep 占住 oneshot；
#   - 校验/重载一律走 systemctl reload，不自己碰进程和信号；
#   - 失败整体还原 last-known-good 目录，不留半新半旧状态；
#   - 代理由配置决定：`auto` 从 setline 配置的 `agent.type` 里读，不必手工挑 timer 实例。
set -euo pipefail

MODE="${1:-}"
case "$MODE" in
  haproxy|nginx|auto) ;;
  *) echo "usage: setline-apply <haproxy|nginx|auto>" >&2; exit 2 ;;
esac

# 默认值可被环境变量或 /etc/setline/apply.conf 覆盖（文件优先级最高）。
SETLINE_BIN="${SETLINE_BIN:-/usr/bin/setline}"
SETLINE_CONFIGS="${SETLINE_CONFIGS:-/etc/setline/setline.json}"
HAPROXY_CONFIGS="${HAPROXY_CONFIGS:-/etc/haproxy/haproxy.cfg /etc/haproxy/conf.d /var/lib/setline/haproxy}"
HAPROXY_FRAGMENT_DIR="${HAPROXY_FRAGMENT_DIR:-/var/lib/setline/haproxy}"
HAPROXY_SERVICE="${HAPROXY_SERVICE:-haproxy}"
NGINX_CONFIG="${NGINX_CONFIG:-/etc/nginx/nginx.conf}"
NGINX_FRAGMENT_DIR="${NGINX_FRAGMENT_DIR:-/var/lib/setline/nginx}"
NGINX_SERVICE="${NGINX_SERVICE:-nginx}"
SETLINE_APPLY_QUIET_SECONDS="${SETLINE_APPLY_QUIET_SECONDS:-15}"
SETLINE_APPLY_STATE_DIR="${SETLINE_APPLY_STATE_DIR:-/var/lib/setline/apply}"
SETLINE_APPLY_RUNTIME_DIR="${SETLINE_APPLY_RUNTIME_DIR:-/run}"
# 片段目录必须归 setline 服务账号所有，否则 setline 写不进片段。只在目录属主是 root 时纠正。
SETLINE_APPLY_FRAGMENT_OWNER="${SETLINE_APPLY_FRAGMENT_OWNER:-setline:beangle}"

if [ -r /etc/setline/apply.conf ]; then
  # shellcheck disable=SC1091
  . /etc/setline/apply.conf
fi

log() { echo "setline-apply[${PROXY:-$MODE}]: $*"; }
# 告警一律走 stderr：detect_proxies 的 stdout 是「代理列表」，被 $(...) 捕获，
# 混进去的行会被当成代理名。
warn() { echo "setline-apply[${PROXY:-$MODE}]: WARNING: $*" >&2; }
die() { echo "setline-apply[${PROXY:-$MODE}]: $*" >&2; exit 1; }
# 配置接线错误与「片段本身不合法」要能区分开，方便运维判断该改哪边。
die_wiring() { echo "setline-apply[${PROXY:-$MODE}]: $*" >&2; exit 3; }

# 从 setline 配置里取 agent.type；配置是唯一事实来源，让 setline 自己解析 JSON，
# shell 侧只做字符串比较，避免手写 JSON 解析。
detect_proxies() {
  local cfg kind proxies=""
  if ! command -v "$SETLINE_BIN" >/dev/null 2>&1; then
    warn "$SETLINE_BIN not found, cannot detect agent.type; nothing to do"
    return 0
  fi
  for cfg in $SETLINE_CONFIGS; do
    [ -e "$cfg" ] || continue
    if ! kind=$("$SETLINE_BIN" -f "$cfg" --agent-type 2>/dev/null); then
      warn "cannot read agent.type from $cfg, skipping"
      continue
    fi
    case "$kind" in
      haproxy|nginx) ;;
      *) continue ;;
    esac
    case " $proxies " in
      *" $kind "*) ;;
      *) proxies="${proxies:+$proxies }$kind" ;;
    esac
  done
  printf '%s\n' "$proxies"
}

# auto：谁被 agent.type 选中就处理谁，一个都不选就什么都不做（普通代理机器上
# timer 会一直空转，这是正常的）。
if [ "$MODE" = "auto" ]; then
  proxies=$(detect_proxies)
  if [ -z "$proxies" ]; then
    log "no agent.type in ${SETLINE_CONFIGS}, nothing to apply"
    exit 0
  fi
  rc=0
  for proxy in $proxies; do
    if ! command -v "$proxy" >/dev/null 2>&1; then
      warn "$proxy is not installed, skipping"
      continue
    fi
    log "applying $proxy (agent.type)"
    child_rc=0
    "$0" "$proxy" || child_rc=$?
    # 片段不合法(1)比接线错误(3)更该被看见，取更严重的那个。
    if [ "$child_rc" -ne 0 ] && { [ "$rc" -eq 0 ] || [ "$child_rc" -eq 1 ]; }; then
      rc=$child_rc
    fi
  done
  exit "$rc"
fi

PROXY="$MODE"
if [ "$PROXY" = "haproxy" ]; then
  FRAG_DIR="$HAPROXY_FRAGMENT_DIR"
  SERVICE="$HAPROXY_SERVICE"
else
  FRAG_DIR="$NGINX_FRAGMENT_DIR"
  SERVICE="$NGINX_SERVICE"
fi
STATE_DIR="$SETLINE_APPLY_STATE_DIR/$PROXY"
LASTGOOD="$STATE_DIR/lastgood"
HASHFILE="$STATE_DIR/applied.sha256"
# 只覆盖 backend 片段（非 *.map）。它没变时说明本次只有路由表变了，可以走热同步。
CFGHASHFILE="$STATE_DIR/applied.cfg.sha256"
LOCKFILE="$SETLINE_APPLY_RUNTIME_DIR/setline-apply-$PROXY.lock"


# FRAG_DIR 会被整体替换，先挡住危险的取值。
case "$FRAG_DIR" in
  /*) ;;
  *) die "fragment dir must be an absolute path: $FRAG_DIR" ;;
esac
[ "$FRAG_DIR" != "/" ] || die "refusing to operate on /"

dir_hash() {
  ( cd "$1" && find . -type f | LC_ALL=C sort | xargs -r sha256sum | sha256sum | cut -d' ' -f1 )
}

# 只对 backend 片段取哈希：*.map 是路由表，可以由 runtime socket 热更新，不触发 reload。
cfg_hash() {
  ( cd "$1" && find . -type f ! -name '*.map' -print0 | LC_ALL=C sort -z |
      xargs -0 -r sha256sum | sha256sum | cut -d' ' -f1 )
}

map_files() {
  find "$FRAG_DIR" -maxdepth 1 -type f -name '*.map' | LC_ALL=C sort
}

validate() {
  if [ "$PROXY" = "haproxy" ]; then
    local args=() f
    for f in $HAPROXY_CONFIGS; do args+=(-f "$f"); done
    haproxy "${args[@]}" -c -q
  else
    nginx -t -c "$NGINX_CONFIG"
  fi
}

# 片段目录必须是服务实际加载的配置的一部分，否则 reload 是静默空转。
# 规则模式（bind 留空）还会多一层：haproxy 的 *.map、nginx 的每个片段文件都必须真的
# 被主配置引用，否则配置合法但规则根本没生效。
check_wiring() {
  if [ "$PROXY" = "haproxy" ]; then
    command -v systemctl >/dev/null 2>&1 || { warn "systemctl missing, cannot verify wiring"; return 0; }
    if ! systemctl show "$SERVICE" -p ExecStart -p Environment 2>/dev/null | grep -qF "$FRAG_DIR"; then
      die_wiring "wiring error: $SERVICE does not load $FRAG_DIR (add -f, or point CFGDIR at it);" \
        "see docs/haproxy-integration.md"
    fi
    check_haproxy_maps
    return 0
  fi
  command -v nginx >/dev/null 2>&1 || return 0
  local dump
  # nginx -T 也会解析片段；校验通过后它仍可能因其它原因失败，那种情况只告警不拦截。
  if ! dump=$(nginx -T -c "$NGINX_CONFIG" 2>/dev/null); then
    warn "cannot dump nginx config, skipping wiring check"
    return 0
  fi
  check_nginx_includes "$dump"
}

# 规则模式：*.map 由主配置 frontend 里的 map_beg(...) 引用。
# 片段目录本身可能出现在 HAPROXY_CONFIGS 里（backend 片段靠 -f <dir> 生效），
# 但 map 文件里印着自己的路径，从那里搜会自证，所以跳过片段目录、并排除 *.map。
check_haproxy_maps() {
  local map f found missing=()
  while IFS= read -r map; do
    [ -n "$map" ] || continue
    found=0
    for f in $HAPROXY_CONFIGS; do
      [ "$f" = "$FRAG_DIR" ] && continue
      if [ -d "$f" ]; then
        grep -rqsF --exclude='*.map' -- "$map" "$f" && { found=1; break; }
      elif [ -f "$f" ]; then
        grep -qsF -- "$map" "$f" && { found=1; break; }
      fi
    done
    [ "$found" = 1 ] || missing+=("$map")
  done < <(find "$FRAG_DIR" -maxdepth 1 -type f -name '*.map' | LC_ALL=C sort)
  [ "${#missing[@]}" -eq 0 ] ||
    die_wiring "wiring error: ${missing[*]} is not referenced by any haproxy config; see docs/haproxy-integration.md"
}

# nginx 的 include 可以带通配符，所以按「生成的文件是否都出现在 nginx -T 里」判断。
check_nginx_includes() {
  local dump="$1" file missing=()
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    printf '%s\n' "$dump" | grep -qF -- "$file" || missing+=("$file")
  done < <(find "$FRAG_DIR" -type f | LC_ALL=C sort)
  [ "${#missing[@]}" -eq 0 ] ||
    die_wiring "wiring error: $NGINX_CONFIG does not include ${missing[*]}; see docs/nginx-integration.md"
}

reload() {
  systemctl reload "$SERVICE"
}

# 片段必须由 setline 服务账号写。如果这目录是 root 建的（setline-apply 先于 setline 跑过，
# 或 lastgood 快照本身是 root 属主），setline 之后就没法往里写片段了。只在属主确实为 root 时
# 纠正，不动部署方刻意设置的其他属主。
ensure_fragment_dir_owner() {
  [ "$(id -u)" -eq 0 ] || return 0
  [ -d "$FRAG_DIR" ] || return 0
  [ "$(stat -c '%u' "$FRAG_DIR" 2>/dev/null || echo 0)" = "0" ] || return 0
  if chown "$SETLINE_APPLY_FRAGMENT_OWNER" "$FRAG_DIR" 2>/dev/null; then
    chmod 0755 "$FRAG_DIR" 2>/dev/null || true
    log "took ownership of $FRAG_DIR as $SETLINE_APPLY_FRAGMENT_OWNER"
  else
    warn "cannot chown $FRAG_DIR to $SETLINE_APPLY_FRAGMENT_OWNER;" \
      "setline may be unable to write fragments"
  fi
}

# haproxy 的 runtime socket 候选，全部自动发现，不引入配置项：
#   1) 运行中单元配置文件里的 `stats socket <path>`（worker 的 runtime API，map 命令都支持）
#   2) 单元 ExecStart 里的 `-S <path>`（master CLI，命令集较小，放后面试）
#   3) 几个发行版默认位置
# 任何一个探不通就换下一个，全都不可用则回退 reload。
list_haproxy_sockets() {
  local f
  for f in $HAPROXY_CONFIGS; do
    if [ -d "$f" ]; then
      grep -rhsE '^[[:space:]]*stats[[:space:]]+socket[[:space:]]+' --include='*.cfg' "$f" 2>/dev/null
    elif [ -f "$f" ]; then
      grep -hsE '^[[:space:]]*stats[[:space:]]+socket[[:space:]]+' "$f" 2>/dev/null
    fi
  done | awk '{print $3}'
  if command -v systemctl >/dev/null 2>&1; then
    systemctl show "$SERVICE" -p ExecStart 2>/dev/null | grep -oE '(^| )-S [^ ]+' | awk '{print $2}'
  fi
  printf '%s\n' \
    /run/haproxy/admin.sock /var/run/haproxy/admin.sock \
    /run/haproxy.sock /var/run/haproxy.sock \
    /run/haproxy/master.sock /var/run/haproxy/master.sock
}

# 只把 *.map 热同步进运行中的 haproxy。返回 1 表示「没有可用的 socket 或同步失败」，
# 调用方据此回退到 reload。每个 map 由 setline 自己算差量、下发并回读校验。
hot_sync_maps() {
  local map socket out maps=()
  while IFS= read -r map; do
    [ -n "$map" ] && maps+=("$map")
  done < <(map_files)
  [ "${#maps[@]}" -gt 0 ] || return 1
  while IFS= read -r socket; do
    [ -n "$socket" ] || continue
    [ -S "$socket" ] || continue
    local ok=1
    for map in "${maps[@]}"; do
      if ! out=$("$SETLINE_BIN" --sync-map "$socket" "$map" 2>&1); then
        log "hot sync of $(basename "$map") via $socket failed: $out"
        ok=0
        break
      fi
    done
    if [ "$ok" = 1 ]; then
      log "hot-synced ${#maps[@]} map file(s) via $socket (no reload)"
      return 0
    fi
  done < <(list_haproxy_sockets | awk 'NF && !seen[$0]++')
  return 1
}

snapshot_lastgood() {
  rm -rf "$LASTGOOD"
  mkdir -p "$LASTGOOD"
  cp -a "$FRAG_DIR"/. "$LASTGOOD"/ 2>/dev/null || true
}

# 只有在存在上一份 good 快照时才可回滚，避免把目录清空。
restore_lastgood() {
  [ -d "$LASTGOOD" ] || return 1
  rm -rf "$FRAG_DIR"
  mkdir -p "$(dirname "$FRAG_DIR")"
  cp -a "$LASTGOOD" "$FRAG_DIR"
  # lastgood 若本身是 root 属主（首次快照就取自 root 建的目录），回滚会把 root 属主带回来。
  ensure_fragment_dir_owner
}

mkdir -p "$STATE_DIR" "$FRAG_DIR" "$SETLINE_APPLY_RUNTIME_DIR"
ensure_fragment_dir_owner

exec 9>"$LOCKFILE"
if ! flock -n 9; then
  log "another run is in progress, skipping"
  exit 0
fi

if [ -z "$(find "$FRAG_DIR" -type f -print -quit)" ]; then
  log "no fragment in $FRAG_DIR, nothing to apply"
  exit 0
fi

# 静默窗口：等到片段不再变化再动手，避免滚动发布期间按中间态反复 reload。
newest=$(find "$FRAG_DIR" -type f -printf '%T@\n' | sort -n | tail -1)
age=$(( $(date +%s) - ${newest%.*} ))
if [ "$age" -lt "$SETLINE_APPLY_QUIET_SECONDS" ]; then
  log "fragment changed ${age}s ago (< ${SETLINE_APPLY_QUIET_SECONDS}s), deferring"
  exit 0
fi

current_hash=$(dir_hash "$FRAG_DIR")
if [ -f "$HASHFILE" ] && [ "$(cat "$HASHFILE")" = "$current_hash" ]; then
  log "fragment unchanged, nothing to do"
  exit 0
fi
# backend 片段（非 *.map）与上次应用内容的哈希：只改路由表时可以不 reload 就地热同步。
new_cfg_hash=$(cfg_hash "$FRAG_DIR")
prev_cfg_hash=$(cat "$CFGHASHFILE" 2>/dev/null || true)

if ! validate; then
  log "validation FAILED for the new fragment"
  if restore_lastgood; then
    log "restored last known good config"
  else
    log "no last known good snapshot, leaving $FRAG_DIR in place"
  fi
  exit 1
fi

# 先校验后查接线：片段本身不合法时 nginx -T 也会失败，若先查接线会被误判成
# 接线错误，从而跳过回滚，把坏片段留在磁盘上。
check_wiring

if ! systemctl is-active --quiet "$SERVICE"; then
  log "$SERVICE is not active; keeping validated fragment, skipping reload"
  snapshot_lastgood
  echo "$current_hash" >"$HASHFILE"
  echo "$new_cfg_hash" >"$CFGHASHFILE"
  exit 0
fi

# 只有 backend 片段与上次应用过的完全一致时才尝试热同步：新增/删除 backend 必须 reload
# 才能让 haproxy 认识，而纯粹的路由表变化可以靠 runtime socket 就地更新，不用打断连接。
# 探测不到可用 socket（或某个 map 同步失败）就落到下面的 reload，行为与以前一致。
if [ -n "$prev_cfg_hash" ] && [ "$new_cfg_hash" = "$prev_cfg_hash" ] && hot_sync_maps; then
  snapshot_lastgood
  echo "$current_hash" >"$HASHFILE"
  echo "$new_cfg_hash" >"$CFGHASHFILE"
  exit 0
fi

if reload; then
  snapshot_lastgood
  echo "$current_hash" >"$HASHFILE"
  echo "$new_cfg_hash" >"$CFGHASHFILE"
  log "reloaded $SERVICE"
  exit 0
fi

log "reload FAILED, rolling back"
if restore_lastgood; then
  reload || log "rollback reload also failed"
  exit 1
fi
log "no last known good snapshot, cannot roll back"
exit 1
