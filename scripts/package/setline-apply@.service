[Unit]
Description=Validate and hot-reload %i with setline-generated config
Documentation=file:///usr/share/doc/setline/agent-reload.md
After=network-online.target
# 本 unit 由 setline-apply@%i.timer 周期驱动，动作本身幂等（内容没变就直接退出），
# 所以关掉启动限流：默认 StartLimitBurst=5/10s 会把高频触发挡成 failed。
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/setline/setline-apply %i
TimeoutStartSec=120s
