#!/bin/bash
# setline-agent: one periodic agent round.
#
# The service unit runs as root only to orchestrate the privilege boundary:
#   - render one round as the setline user through `setline render`;
#   - validate and reload the fragments as root through `setline-apply`.
#
# Rendering must never happen in this process: setline parses HTTP responses
# from peers, and the project requires that parser to stay unprivileged.
set -euo pipefail

SETLINE_BIN="${SETLINE_BIN:-/usr/bin/setline}"
SETLINE_CONF="${SETLINE_CONF:-/etc/setline/setline.conf}"
SETLINE_APPLY="${SETLINE_APPLY:-/usr/lib/setline/setline-apply}"
RUN_USER="${SETLINE_AGENT_USER:-setline}"
RUN_GROUP="${SETLINE_AGENT_GROUP:-beangle}"

log() { echo "setline-agent: $*"; }
die() { echo "setline-agent: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "must run as root (setline-apply needs to reload the proxy)"
[ -x "$SETLINE_BIN" ] || die "$SETLINE_BIN not found"
[ -x "$SETLINE_APPLY" ] || die "$SETLINE_APPLY not found"
[ -f "$SETLINE_CONF" ] || die "control config not found: $SETLINE_CONF"
command -v runuser >/dev/null 2>&1 || die "runuser not found (install util-linux)"

agent_type="$("$SETLINE_BIN" --agent-type --conf "$SETLINE_CONF")" ||
  die "cannot read [agent] type from $SETLINE_CONF"
if [ -z "$agent_type" ]; then
  log "no [agent] type in $SETLINE_CONF, nothing to do"
  exit 0
fi

# The renderer reads remote route tables when peers are configured, so drop to
# setline. Rendering is complete when this process returns; no quiet window is
# needed before validation and reload.
runuser -u "$RUN_USER" -g "$RUN_GROUP" -- \
  "$SETLINE_BIN" render --conf "$SETLINE_CONF"
"$SETLINE_APPLY" --now auto
