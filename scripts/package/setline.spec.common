# 版本无关的 spec 片段：安装后要跑的脚本段 + 打包文件清单。
#
# build_rpm.sh（用预编译产物打二进制包）和 build_srpm.sh（从源码包重编）都把这
# 个文件原样拼进自己生成的 spec，所以「SRPM 重编出来的包」与「直接发布的包」装的
# 是同一批文件、跑的是同一批脚本。要增删包内文件或改脚本段，只改这里：两边的文件
# 清单是同一份，哪一边的安装段漏装了文件，rpmbuild 会直接报 File not found。
#
# 注意：注释里不要写出「百分号 + 段名」的形式（installation、file list 段如此，
# pre/post 段同理）。老版 rpm（CentOS 7 的 4.11）会把注释行里的段名当成段标记截断，
# 剩下的文字会被当作要执行的命令，报 command not found。两个打包脚本里有检查。

%pre
getent group beangle >/dev/null 2>&1 || groupadd -r beangle
if ! getent passwd setline >/dev/null 2>&1; then
  useradd -r -g beangle -d /var/lib/setline -s /sbin/nologin -c "Setline proxy" setline
else
  usermod -g beangle setline 2>/dev/null || :
fi
mkdir -p /var/lib/setline /var/log/setline /var/lib/setline/haproxy /var/lib/setline/nginx /var/lib/setline/apply

%post
mkdir -p /etc/setline
if [ ! -f /etc/setline/setline.json ]; then
  cp -f /usr/share/setline/setline.json.default /etc/setline/setline.json
fi
if [ ! -f /etc/setline/setline.conf ]; then
  cp -f /usr/share/setline/setline.conf.default /etc/setline/setline.conf
fi
chown setline:beangle /etc/setline/setline.json
chmod 0664 /etc/setline/setline.json
chown root:beangle /etc/setline/setline.conf
chmod 0640 /etc/setline/setline.conf
chown setline:beangle /etc/setline
chmod 2775 /etc/setline
chown -R setline:beangle /var/lib/setline /var/log/setline
chmod 2775 /var/lib/setline /var/log/setline
chmod 0755 /var/lib/setline/haproxy /var/lib/setline/nginx /var/lib/setline/apply
# 旧版把渲染和 apply 拆成两个 timer。升级时清掉它们的 enable 链接；
# 如果其中任何一个原本启用，就把启用意图迁移到新的合并 timer。
migrated=0
was_active=0
for unit in setline-render.timer setline-apply.timer; do
  link="/etc/systemd/system/timers.target.wants/$unit"
  if [ -L "$link" ]; then
    migrated=1
    systemctl is-active --quiet "$unit" 2>/dev/null && was_active=1
    systemctl stop "$unit" 2>/dev/null || :
    rm -f "$link"
  fi
done
if [ "$migrated" = 1 ] && [ -f /usr/lib/systemd/system/setline-agent.timer ]; then
  systemctl enable setline-agent.timer 2>/dev/null || :
  # 旧 timer 原本在跑时，新 timer 也要立刻接上，不能等到下次重启。
  [ "$was_active" = 0 ] || systemctl start setline-agent.timer 2>/dev/null || :
fi
for link in /etc/systemd/system/timers.target.wants/setline-apply@*.timer; do
  [ -e "$link" ] || continue
  rm -f "$link"
done
systemctl daemon-reload 2>/dev/null || :

%preun
if [ "$1" = 0 ]; then
  systemctl stop setline 2>/dev/null || :
  systemctl disable setline 2>/dev/null || :
  systemctl disable --now setline-agent.timer 2>/dev/null || :
  # setline-render/setline-apply 和 setline-apply@*.timer 是旧版单元，
  # 从这里升级上来的机器可能还留着 enable 链接。
  for unit in /etc/systemd/system/timers.target.wants/setline-agent.timer /etc/systemd/system/timers.target.wants/setline-render.timer /etc/systemd/system/timers.target.wants/setline-apply.timer /etc/systemd/system/timers.target.wants/setline-apply@*.timer; do
    [ -e "$unit" ] || continue
    rm -f "$unit"
  done
fi

%postun
systemctl daemon-reload 2>/dev/null || :

# /etc/setline/setline.conf and setline.json are created by the post scriptlet
# and kept out of the file list, so package removal preserves local config.
%files
%attr(0755,root,root) /usr/bin/setline
%attr(0644,root,root) /usr/share/setline/setline.json.default
%attr(0644,root,root) /usr/share/setline/setline.conf.default
%attr(0644,root,root) /usr/share/setline/haproxy-setline-cfgdir.conf.example
%attr(0644,root,root) /usr/share/doc/setline/*.md
%attr(0755,root,root) /usr/lib/setline/setline-apply
%attr(0755,root,root) /usr/lib/setline/setline-agent
%attr(0644,root,root) /usr/lib/systemd/system/setline.service
%attr(0644,root,root) /usr/lib/systemd/system/setline-agent.service
%attr(0644,root,root) /usr/lib/systemd/system/setline-agent-interval.service
%attr(0644,root,root) /usr/lib/systemd/system/setline-agent.timer
