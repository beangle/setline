[Unit]
Description=Render and apply setline peer/local fragments
Documentation=file:///usr/share/doc/setline/agent-reload.md
Documentation=file:///usr/share/doc/setline/haproxy-integration.md
Documentation=file:///usr/share/doc/setline/nginx-integration.md
After=network-online.target

[Service]
Type=oneshot
# 由 setline-agent.timer 周期驱动。这里只做 peers/本地路由的 render/apply，
# 不执行 bashub 的 pull/check；远程刷新在 setline-agent.service 启动/reload 时完成。
# 连续几轮 peer 不可达不应把 unit 挡成 failed，所以关掉启动限流。
# 拼写用旧式的 [Service] StartLimitInterval=，理由见 setline.service 与 docs/deployment.md。
StartLimitInterval=0
# 本服务以 root 运行，但只做编排：渲染通过 runuser 降权到 setline 用户，
# 校验/reload 由 root 的 setline-apply 完成。绝不在 root 进程里解析 peer 响应。
UMask=0002
ExecStart=/usr/lib/setline/setline-agent --interval
TimeoutStartSec=120s
