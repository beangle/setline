[Unit]
Description=Periodically render and apply setline topology fragments
Documentation=file:///usr/share/doc/setline/agent-reload.md
Documentation=file:///usr/share/doc/setline/haproxy-integration.md
Documentation=file:///usr/share/doc/setline/nginx-integration.md

[Timer]
# 定时轮次只做 peers/本地路由的渲染和 apply；不访问 bashub。
# 实际执行的是 static 的 setline-agent.service。
# 常驻 setline.service 仍可同时监听/代理。节奏交给 systemd，
# 进程内不维护调度循环，systemctl list-timers / journalctl 直接可见。
Unit=setline-agent.service
OnBootSec=30s
OnUnitInactiveSec=30s
AccuracySec=1s

[Install]
WantedBy=timers.target
