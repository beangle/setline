[Unit]
Description=Setline local HTTP path proxy
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/setline --conf /etc/setline/setline.conf
Restart=on-failure
RestartPreventExitStatus=2
# 收到 SIGTERM 后 setline 会停监听、把在途请求跑完再退出；这里给的时间要大于
# readTimeoutMillis（默认 15000），否则一个即将超时的请求会被 systemd 直接打断，
# 客户端看到的是连接重置而不是 504。调大 readTimeoutMillis 时同步调大它。
TimeoutStopSec=30
# StartLimit* 用 [Service] + 无 Sec 后缀的旧拼写：CentOS 7 的 systemd 219 只认这一种，
# [Unit] StartLimitIntervalSec= 是 229 才有的，219 上会报 Unknown lvalue 并忽略；
# 旧拼写在新 systemd（实测 259）上仍然生效且无告警，两边共用一份 unit。
StartLimitBurst=5
StartLimitInterval=120
StandardOutput=journal
StandardError=journal
# User=/Group= 是硬性要求，不是可调项：setline 是面向网络的数据平面，以 root 运行会把
# 任一解析/内存 bug 直接变成 root 失陷。特权统一留给短命的 setline-agent/setline-apply。
# 需要绑 1024 以下端口时用 AmbientCapabilities=CAP_NET_BIND_SERVICE，别去掉这两行。
# 详见 docs/project-constraints.md 的 Privilege Model。
User=setline
Group=beangle
UMask=0002
# 默认 maxConnections=65535 时预算为 2*65535+64=131134；调大配置时同步上调。
LimitNOFILE=131134

[Install]
WantedBy=multi-user.target
