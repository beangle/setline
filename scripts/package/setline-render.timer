[Unit]
Description=Periodically render setline agent fragments
Documentation=file:///usr/share/doc/setline/deployment.md
Documentation=file:///usr/share/doc/setline/haproxy-integration.md
Documentation=file:///usr/share/doc/setline/nginx-integration.md

[Timer]
# 纯渲染机（配了 agent 的 peers、没有 listen）没有常驻的必要：setline 每次跑一轮
# 写完片段就退出，周期刷新交给 systemd，而不是让进程自己 sleep——节奏在 systemctl /
# journalctl 里看得见，也不必再维护一个 sync/intervalMillis 配置项。
# OnBootSec 负责第一轮；之后靠 OnUnitInactiveSec 每一轮跑完再排下一轮。用 timer 而不是
# path 单元的理由见 docs/agent-reload.md。
OnBootSec=30s
OnUnitInactiveSec=30s
AccuracySec=1s

[Install]
WantedBy=timers.target
