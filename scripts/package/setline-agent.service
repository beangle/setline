[Unit]
Description=Render and apply setline topology fragments
Documentation=file:///usr/share/doc/setline/agent-reload.md
Documentation=file:///usr/share/doc/setline/haproxy-integration.md
Documentation=file:///usr/share/doc/setline/nginx-integration.md
After=network-online.target

[Service]
Type=oneshot
# 由 setline-agent.timer 周期触发：条件 GET manifest；未变化时直接退出，
# 变化时拉取资源并 render/apply。需要手工刷新时执行 setline-agent-run --remote。
# 连续几轮失败不应把 unit 挡成 failed，所以关掉启动限流。
# 拼写用旧式的 [Service] StartLimitInterval=，理由见 setline.service 与 docs/deployment.md。
StartLimitInterval=0
# 本服务以 root 运行，但只做编排：渲染通过 runuser 降权到 setline 用户，
# 校验/reload 由 root 的 setline-apply 完成。绝不在 root 进程里解析远端响应。
UMask=0002
ExecStart=/usr/lib/setline/setline-agent-run --remote
TimeoutStartSec=120s
