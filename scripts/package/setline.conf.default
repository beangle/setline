# setline-agent local control plane.
#
# The resident setline service reads setline.json only. This file configures
# setline-agent: remote downloads, fragment rendering and proxy reloads.
# `setline-agent init` writes this template only when the target does not exist;
# package upgrades keep the existing file.

[remote]
# bashub root URL. Do not append /api or the Project name.
# Used only by an explicit `setline-agent pull` (or `setline-agent-run --remote`).
# The timer-driven setline-agent.service never contacts this URL.
# The download runs unprivileged, and root installs the verified staging.
url = http://127.0.0.1:8082
# Project qualified name, e.g. openurp.prod.
project = org.name
# Optional local IP used by bashub to select this machine's routes.
#ip = 192.168.1.10
# Project.key. Sent as `Authorization: Bearer <project>:<key>`.
token = change-me

[proxy]
# Optional. Defaults from [agent] type:
#   haproxy -> /etc/haproxy/haproxy.cfg
#   nginx   -> /etc/nginx/nginx.conf
#file = /etc/haproxy/haproxy.cfg

[agent]
# haproxy or nginx. Empty disables fragment rendering.
type = haproxy
# Fragment root. Defaults to /var/lib/setline when type is set.
output = /var/lib/setline

[apply]
# The proxy is selected by [agent] type. The following values are derived from
# it when omitted:
#
#type = haproxy
#configs = /etc/haproxy/haproxy.cfg /etc/haproxy/conf.d /var/lib/setline/haproxy
#fragmentDir = /var/lib/setline/haproxy
#service = haproxy

# Wait this many seconds after the newest fragment change before reloading.
quietSeconds = 15
# Apply state is fixed at <agent.output>/apply.
runtimeDir = /run
# Only a fragment directory owned by root is corrected to this owner.
owner = setline:beangle
