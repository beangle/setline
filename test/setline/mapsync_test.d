module setline.mapsync_test;

import std.exception : assertThrown;

import setline.mapsync;

@("mapsync parses generated map files") unittest {
  auto entries = parseMapFile("# Generated by setline. Do not edit by hand.\n" ~
    "#   http-request set-var(txn.setline_path) path\n" ~
    "\n" ~
    "app.example.com~/tools be_app1_app_example_com_tools\n" ~
    "/ be_app1__\n");
  assert(entries.length == 2);
  assert(entries[0].key == "app.example.com~/tools");
  assert(entries[0].value == "be_app1_app_example_com_tools");
  assert(entries[1].key == "/");
  assert(entries[1].value == "be_app1__");
}

@("mapsync parses show map output") unittest {
  auto entries = parseShowMap("0x55609ebea9f0 app.example.com~/tools be_tools\n\n");
  assert(entries.length == 1);
  assert(entries[0].key == "app.example.com~/tools");
  assert(entries[0].value == "be_tools");
  // 合法但为空的 map 回的是空行，不是错误。
  assert(parseShowMap("\n").length == 0);
}

@("mapsync rejects unknown map replies") unittest {
  assertThrown(parseShowMap("Unknown map identifier. Please use #<id> or <file>.\n\n"));
}

@("mapsync diffs added updated removed") unittest {
  MapEntry[] current = [MapEntry("a~/1", "be_x"), MapEntry("b~/2", "be_y")];
  MapEntry[] desired = [MapEntry("a~/1", "be_z"), MapEntry("c~/3", "be_w")];
  auto change = diffMap(current, desired);
  assert(change.added.length == 1 && change.added[0].key == "c~/3");
  assert(change.updated.length == 1 && change.updated[0].key == "a~/1");
  assert(change.removed.length == 1 && change.removed[0].key == "b~/2");
}

@("mapsync reports no change when identical") unittest {
  MapEntry[] entries = [MapEntry("a~/1", "be_x")];
  auto change = diffMap(entries, entries);
  assert(change.added.length == 0);
  assert(change.updated.length == 0);
  assert(change.removed.length == 0);
}

@("mapsync treats duplicate keys as update") unittest {
  // `add map` 对已存在的 key 是追加，会留下重复条目；重复时 haproxy 采用先插入的值，
  // 所以哪怕第一条值相同，也必须当作改值走重建。
  MapEntry[] current = [MapEntry("a~/1", "be_x"), MapEntry("a~/1", "be_y")];
  auto change = diffMap(current, [MapEntry("a~/1", "be_x")]);
  assert(change.updated.length == 1);
  assert(change.added.length == 0);
  assert(change.removed.length == 0);
}
