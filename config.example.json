{
  "listen": 8080,
  "adminToken": "change-me",
  "connectTimeoutMillis": 3000,
  "healthCheck": {
    "intervalMillis": 5000,
    "timeoutMillis": 1000,
    "unhealthyThreshold": 2,
    "healthyThreshold": 1
  },
  "agent": {
    "type": "nginx",
    "output": "/var/lib/setline/nginx/setline.conf",
    "bind": "*:80",
    "token": "change-me",
    "sync": {
      "mode": "once",
      "intervalMillis": 30000
    },
    "peers": [
      {
        "name": "app1",
        "url": "http://10.0.1.10:8080"
      },
      {
        "name": "app2",
        "url": "http://10.0.1.11:8080",
        "token": "app2-token"
      }
    ]
  },
  "routes": {
    "*": {
      "/api/edu": [9002, 9003],
      "/m/edu/learning": [5173, 4545],
      "/api": 9001
    },
    "local2.example.com": {
      "/api": 9081
    }
  }
}
