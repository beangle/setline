{
  "listen": 8080,
  "adminListen": "127.0.0.1:8081",
  "connectTimeoutMillis": 3000,
  "readTimeoutMillis": 15000,
  "reusePort": false,
  "accessLog": false,
  "upstreamIdleTimeoutMillis": 30000,
  "webSocketIdleTimeoutMillis": 0,
  "maxConnections": 65535,
  "healthCheck": {
    "intervalMillis": 5000,
    "timeoutMillis": 1000,
    "unhealthyThreshold": 2,
    "healthyThreshold": 1
  },
  "agent": {
    "type": "haproxy",
    "output": "/var/lib/setline"
  },
  "routes": {
    "*": {
      "/api/edu": [9002, 9003],
      "/m/edu/learning": [5173, 4545],
      "/api": 9001
    },
    "local2.example.com": {
      "/api": 9081
    }
  }
}
